# Copy to .env and enter your local MySQL credentials. Never commit .env.
# npm start / npm run dev require Node.js 22 or later.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=recruiting_website
# Required for resume feedback and AI job matching. Never commit the real key.
GEMINI_API_KEY=replace_with_your_gemini_api_key
# GEMINI_MODEL=gemini-flash-lite-latest

# Local defaults remain usable without these settings. Never put real secrets here.
PORT=3000
NODE_ENV=development
# Production requires a randomly generated SESSION_SECRET of at least 32 bytes.
# SESSION_SECRET=
# Defaults to memory locally, mysql in production. MySQL sessions require
# deployment/sessions.sql to be applied to the selected database first.
# SESSION_STORE=mysql
# Set only after checking the host's actual proxy topology; 0 trusts no proxy.
TRUST_PROXY=0
# Enable for a database service that requires TLS. Certificate checks stay enabled.
DB_SSL=false
# DB_SSL_CA_FILE=/absolute/path/to/provider-ca.pem
